# Copy to .env for LOCAL DEVELOPMENT ONLY (this file is auto-loaded by `bun run`).
# For real/agent use, prefer the config file ~/.config/seerr/config (chmod 600)
# or the SEERR_API_KEY environment variable — see README "Security".
#
# The CLI NEVER accepts the API key as a command-line flag, so it can't leak
# into shell history, process lists, or an AI agent's transcript.

# Your Seerr instance URL (REQUIRED — no default). Example:
SEERR_URL=http://localhost:5055

# API key from Seerr → Settings → General → API Key
SEERR_API_KEY=your-seerr-api-key-here
